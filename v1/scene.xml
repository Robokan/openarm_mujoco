<mujoco model="openarm_bimanual scene">
  <include file="openarm_bimanual.xml"/>

  <!-- Stronger friction solving so grasped objects don't slowly creep out. -->
  <option impratio="20" noslip_iterations="5" cone="elliptic"/>

  <statistic center="0 0 0.43" extent=".85" meansize="0.05"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="160" elevation="-10"/>
    <quality shadowsize="8192"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
    <material name="table_mat" rgba="0.55 0.38 0.22 1" reflectance="0.1"/>
    <material name="cube_mat" rgba="0.85 0.2 0.15 1" reflectance="0.2"/>
  </asset>

  <worldbody>
    <light pos="0 0 1.5" dir="0 0 -1" directional="true"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"
      contype="1" conaffinity="1" friction="1 0.005 0.0001"/>

    <!-- Table in front of the arms (~1 inch past the torso). Top surface z = 0.37 m. -->
    <body name="table" pos="0.305 0 0">
      <geom name="table_top" type="box" size="0.25 0.40 0.02" pos="0 0 0.35"
        material="table_mat" contype="1" conaffinity="1" friction="1 0.005 0.0001"/>
      <geom name="table_leg_fl" type="box" size="0.02 0.02 0.165" pos=" 0.20  0.35 0.165"
        material="table_mat" contype="1" conaffinity="1"/>
      <geom name="table_leg_fr" type="box" size="0.02 0.02 0.165" pos=" 0.20 -0.35 0.165"
        material="table_mat" contype="1" conaffinity="1"/>
      <geom name="table_leg_bl" type="box" size="0.02 0.02 0.165" pos="-0.20  0.35 0.165"
        material="table_mat" contype="1" conaffinity="1"/>
      <geom name="table_leg_br" type="box" size="0.02 0.02 0.165" pos="-0.20 -0.35 0.165"
        material="table_mat" contype="1" conaffinity="1"/>
    </body>

    <!-- 5 cm free cube on the table — pickable by the gripper. -->
    <body name="cube" pos="0.305 0 0.395">
      <freejoint name="cube_free"/>
      <geom name="cube" type="box" size="0.025 0.025 0.025" mass="0.03"
        material="cube_mat" contype="1" conaffinity="1" condim="4"
        friction="4 0.5 0.1" priority="1" solref="0.002 1"/>
    </body>
  </worldbody>
</mujoco>
