<mujoco model="openarm_bimanual scene">
  <include file="openarm_bimanual.xml"/>

  <!-- Stronger friction solving so grasped objects don't slowly creep out. -->
  <!-- nativeccd off: with MuJoCo's native convex collider the mesh soles' contact
       points flickered and stacked bars visibly shook at rest (top of a 5-pile
       wandered ~0.9 mm, 70 mm/s twitches); libccd holds them still (0.05 mm). -->
  <option impratio="20" noslip_iterations="5" cone="elliptic">
    <flag nativeccd="disable"/>
  </option>

  <statistic center="0 0 0.43" extent=".85" meansize="0.05"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="160" elevation="-10"/>
    <quality shadowsize="8192"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
    <material name="table_mat" rgba="0.55 0.38 0.22 1" reflectance="0.1"/>
    <material name="cube_mat" rgba="0.85 0.2 0.15 1" reflectance="0.2"/>
    <!-- 50 x 50 x 2 mm slab: the sole under each chocolate bar -->
    <mesh name="bar_sole" vertex="-0.025 -0.025 -0.001  0.025 -0.025 -0.001  0.025 0.025 -0.001  -0.025 0.025 -0.001
                                  -0.025 -0.025  0.001  0.025 -0.025  0.001  0.025 0.025  0.001  -0.025 0.025  0.001"/>
    <texture name="sign_tex_0" type="2d" builtin="flat" rgb1="1 1 1" width="64" height="64"/>
    <material name="sign_mat_0" texture="sign_tex_0" specular="0" shininess="0"/>
    <texture name="sign_tex_1" type="2d" builtin="flat" rgb1="1 1 1" width="64" height="64"/>
    <material name="sign_mat_1" texture="sign_tex_1" specular="0" shininess="0"/>
    <texture name="sign_tex_2" type="2d" builtin="flat" rgb1="1 1 1" width="64" height="64"/>
    <material name="sign_mat_2" texture="sign_tex_2" specular="0" shininess="0"/>
    <texture name="sign_tex_3" type="2d" builtin="flat" rgb1="1 1 1" width="64" height="64"/>
    <material name="sign_mat_3" texture="sign_tex_3" specular="0" shininess="0"/>
    <texture name="sign_tex_4" type="2d" builtin="flat" rgb1="1 1 1" width="64" height="64"/>
    <material name="sign_mat_4" texture="sign_tex_4" specular="0" shininess="0"/>
    <texture name="sign_tex_5" type="2d" builtin="flat" rgb1="1 1 1" width="64" height="64"/>
    <material name="sign_mat_5" texture="sign_tex_5" specular="0" shininess="0"/>
  </asset>

  <worldbody>
    <light pos="0 0 1.5" dir="0 0 -1" directional="true"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"
      contype="1" conaffinity="1" friction="1 0.005 0.0001"/>

    <!-- Table in front of the arms (~1 inch past the torso). Top surface z = 0.37 m. -->
    <body name="table" pos="0.305 0 0">
      <geom name="table_top" type="box" size="0.25 0.40 0.02" pos="0 0 0.35"
        material="table_mat" contype="1" conaffinity="1" friction="1 0.005 0.0001"/>
      <geom name="table_leg_fl" type="box" size="0.02 0.02 0.165" pos=" 0.20  0.35 0.165"
        material="table_mat" contype="1" conaffinity="1"/>
      <geom name="table_leg_fr" type="box" size="0.02 0.02 0.165" pos=" 0.20 -0.35 0.165"
        material="table_mat" contype="1" conaffinity="1"/>
      <geom name="table_leg_bl" type="box" size="0.02 0.02 0.165" pos="-0.20  0.35 0.165"
        material="table_mat" contype="1" conaffinity="1"/>
      <geom name="table_leg_br" type="box" size="0.02 0.02 0.165" pos="-0.20 -0.35 0.165"
        material="table_mat" contype="1" conaffinity="1"/>
    </body>

    <!-- 5 cm free cube on the table — pickable by the gripper. -->
    <!-- Colour-sorting drop pads (visual only: cubes rest on the table). -->
    <geom name="pad_left" type="box" size="0.06 0.06 0.0015" pos="0.20 0.30 0.3715"
      rgba="0.55 0.55 0.55 1" contype="0" conaffinity="0"/>
    <geom name="pad_right" type="box" size="0.06 0.06 0.0015" pos="0.20 -0.30 0.3715"
      rgba="0.55 0.55 0.55 1" contype="0" conaffinity="0"/>
    <body name="cube" pos="0.305 0 0.395">
      <freejoint name="cube_free"/>
      <geom name="cube" type="box" size="0.025 0.025 0.025" mass="0.03"
        material="cube_mat" contype="1" conaffinity="1" condim="4"
        friction="4 0.5 0.1" priority="1" solref="0.002 1"/>
    </body>

    <!-- Chocolate bars: a pool of 27 free bodies (up to 9 stacks of 3 plus a pile)
         arranged per trial by the pick generators, which may override size and
         colour at runtime (model.geom_size / geom_rgba). Unused bars park in the
         warehouse row behind the robot.
         Stacking: two near-identical boxes face-to-face overflow MuJoCo's box-box
         contact buffer (9 contacts, fatal), so bar boxes never collide with each
         other (contype 2 / conaffinity 1: boxes still meet the table and the
         fingers, which are 1/1). A bar rests on the bar below through a thin MESH
         sole (1/1) that protrudes 1 mm under its box: mesh-vs-box goes through the
         general convex collider (multiccd, so a flat face gets several contacts
         and the bar sits flat wherever it lands on the pile; nativeccd disabled,
         see the option flag above). -->
    <body name="bar_0" pos="-0.55 -0.66 0.0135">
      <freejoint name="bar_0_free"/>
      <geom name="bar_0" type="box" size="0.025 0.025 0.0125" mass="0.06"
